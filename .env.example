# PostgreSQL connection (docker compose exposes this on localhost:5432)
DATABASE_URL=postgres://databrain:databrain@localhost:5432/databrain
# Used only by the integration/e2e test suites (it is reset on every run)
TEST_DATABASE_URL=postgres://databrain:databrain@localhost:5432/databrain_test

# Secret used to sign session cookies. Generate one: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-value

# Demo mode: visitors without a session are signed in as the seeded demo user.
# Set to "false" for any shared or production deployment.
DATABRAIN_DEMO_MODE=true

# Language model: "local" (rule-based, no network) or "anthropic" (Claude).
# With "anthropic", project briefs and retrieved knowledge passages are sent to the Anthropic API.
LLM_PROVIDER=local
# Required when LLM_PROVIDER=anthropic. Server-side only; never commit a real key.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# These three have local implementations only.
EMBEDDING_PROVIDER=local
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage
DEPLOYMENT_ADAPTER=local-simulator

# Knowledge is flagged stale when last verified more than this many days ago.
FRESHNESS_POLICY_DAYS=180
